# Porta da API
PORT=3333

# Segredo para assinar tokens JWT (OBRIGATÓRIO em produção — use um valor longo e aleatório)
JWT_SECRET=troque-por-um-segredo-forte

# Caminho do arquivo SQLite
DB_PATH=./data/printflow.db

# Cria usuário e dados de demonstração automaticamente se o banco estiver vazio
SEED_DEMO=true
